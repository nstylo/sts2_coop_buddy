<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../GamePaths.props" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>RewardViewer.RuntimeTests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="PortabilityChecks.cs" />
    <ProjectReference Include="../RewardViewer.csproj" />
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" />
  </ItemGroup>
</Project>
