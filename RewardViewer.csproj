<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="GamePaths.props" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RewardViewer</AssemblyName>
    <Version>0.5.2</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Compile Remove="tests/**/*.cs" />
    <None Update="RewardViewer.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckGameAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="STS2 assemblies not found. Set Sts2DataDir in local.props or pass -p:Sts2DataDir=/path/to/game/data." />
  </Target>
  <Target Name="PackageMod" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/RewardViewer.json" DestinationFolder="$(MSBuildProjectDirectory)/dist/RewardViewer" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)/dist/RewardViewer" DestinationFile="$(MSBuildProjectDirectory)/dist/RewardViewer-$(Version).zip" Overwrite="true" />
  </Target>
</Project>
